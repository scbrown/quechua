quechua:TriggeredByShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:property [ sh:or ( [ sh:class quechua:CronJob ] [ sh:class quechua:SystemdTimer ] [ sh:class quechua:Script ] [ sh:class quechua:GitCommit ] [ sh:class quechua:CLI ] ) ;
            sh:path quechua:triggered_by ] ;
