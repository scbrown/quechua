quechua:FileCollectionShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class quechua:NFSExport ;
            sh:maxCount 1 ;
            sh:path quechua:inExport ],
        [ sh:class quechua:FileCollection ;
            sh:maxCount 1 ;
            sh:path quechua:parentCollection ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path quechua:relativePath ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path quechua:fileCount ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path quechua:byteCount ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path quechua:newestMtime ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ],
        [ sh:datatype xsd:string ;
            sh:path quechua:hasExtension ;
            sh:pattern "^\\.[a-z0-9_+-]{1,16}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path quechua:extensionCounts ] ;
    sh:targetClass quechua:FileCollection .

