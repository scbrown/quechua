        [ sh:maxCount 1 ;
            sh:path quechua:verifiedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
    sh:targetClass quechua:Verification .

